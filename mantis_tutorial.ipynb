          "text": [
            "Forecast shape: (21, 16)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Step 5 · Plot the forecasts\n",
        "\n",
        "Plot the forecasts with previously observed deaths and hospitalizations. In each panel, the blue line is the median forecast, the blue band is the central 90% prediction interval, and the black line shows the observed values."
      ],
      "metadata": {
        "id": "Fzdq1msQO-n1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "lower, median, upper = [model.quantiles.index(q) for q in (0.05, 0.5, 0.95)]\n",
        "fig, axes = plt.subplots(2, 1, figsize=(9, 6), sharex=True)\n",
        "\n",
        "for i, (ax, observed, label) in enumerate(zip(\n",
        "    axes, [deaths_ts, hosp_ts], [\"Weekly deaths\", \"Weekly hospitalizations\"]\n",
        ")):\n",
        "    ax.plot(observed, color=\"black\", label=\"Observed\")\n",
        "\n",
        "    weeks = range(start, start + model.prediction_length)\n",
        "    series = forecasts[i]\n",
        "    ax.plot(\n",
        "        weeks, series[median], color=\"tab:blue\",\n",
        "        label=\"Median forecast\",\n",
        "    )\n",
        "    ax.fill_between(\n",
        "        weeks, series[lower], series[upper], color=\"tab:blue\", alpha=0.2,\n",
        "        label=\"90% prediction interval\",\n",
        "    )\n",
        "\n",
        "    ax.set_ylabel(label)\n",
        "\n",
        "axes[0].set_title(\"Mantis 2 COVID-19 forecasts for Michigan\")\n",
        "axes[0].legend()\n",
        "axes[1].set_xlabel(\"Week index\")\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
